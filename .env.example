# ============================================================
#  Appointment Assistance System — Environment Configuration
#  Copy this file to .env and fill in your credentials.
#  NEVER commit your actual .env file to version control.
# ============================================================

# Required: OpenAI API key
# Used for: intent detection LLM, draft generation LLM, moderation API
OPENAI_API_KEY=sk-your-api-key-here

# Optional: specify a different primary model (default: gpt-4o-mini)
# OPENAI_PRIMARY_MODEL=gpt-4o-mini

# Optional: specify a different fallback model (default: gpt-3.5-turbo)
# OPENAI_FALLBACK_MODEL=gpt-3.5-turbo
